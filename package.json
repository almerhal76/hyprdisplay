{
  "name": "hyprdisplay",
  "version": "0.1.5",
  "description": "Desktop App for Hyprland Display Management",
  "repository": {
    "type": "git",
    "url": "https://github.com/almerhal76/hyprdisplay.git"
  },
  "main": "./out/main/index.js",
  "author": "alfian",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:linux": "electron-vite build && electron-builder --linux",
    "release:linux": "electron-vite build && electron-builder --linux --publish always"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "axios": "^1.13.5",
    "electron-updater": "^6.8.3",
    "framer-motion": "^11.11.11",
    "lucide-react": "^0.473.0",
    "sonner": "^1.7.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.7.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "hyprdisplay",
    "productName": "hyprdisplay",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "resources/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Settings",
      "executableName": "hyprdisplay"
    }
  }
}
